{
  "name": "learnharness-anki-bridge",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "Unofficial graph-to-Anki drafting, review and one-way AnkiConnect delivery.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "bench:fixtures": "node bench/extract-fixtures.ts",
    "bench:run": "node bench/run.ts",
    "bench:score": "node bench/score-server.ts",
    "bench:summary": "node bench/summarise.ts",
    "build": "node scripts/build.mjs",
    "package:plugin": "node scripts/package-plugin.mjs",
    "install:local": "npm run build && node scripts/install-plugin-local.mjs",
    "test:anki-live": "node scripts/test-anki-live.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "mathjax": "^3.2.2",
    "typescript": "^5.9.0"
  }
}
